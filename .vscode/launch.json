{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32 Debug (Debug ELF)",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "deviceName": "STM32G474RET6",
            "deviceCore": "Cortex-M4",
            "preBuild": "",
            "preLaunchTask": "Build Debug",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/glove_UMI_APP.elf",
                    "symbolFileName": "${workspaceFolder}/build/Debug/glove_UMI_APP.elf"
                }
            ]
        },
        {
            "name": "OpenOCD Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "d:\\InternWork\\Code\\Test_mygit\\Tacapp_init\\build\\Debug\\glove_UMI_APP.elf",
            "svdPath": "",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Set remote target to port 3333",
                    "text": "target remote :3333",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
